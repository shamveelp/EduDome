generator client {
  provider = "prisma-client"
  output   = "../src/shared/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  AGENCY
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
